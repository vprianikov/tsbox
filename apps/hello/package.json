{
  "name": "@tsbox/hello-app",
  "version": "0.1.0",
  "private": true,
  "description": "Hello World API powered by Hono and Bun",
  "homepage": "https://github.com/vprianikov/tsbox/tree/master/apps/hello#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprianikov/tsbox.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Vasilii Prianikov",
    "email": "88191516+vprianikov@users.noreply.github.com"
  },
  "type": "module",
  "scripts": {
    "check": "bun run --cwd ../.. check",
    "clean": "bun run --cwd ../.. clean",
    "dev": "bun run --watch src/app.ts",
    "fix": "bun run --cwd ../.. fix",
    "start": "bun run src/app.ts",
    "test": "bun run vitest run --reporter=agent",
    "typecheck": "bun run tsc --noEmit"
  },
  "dependencies": {
    "hono": "catalog:backend"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:base",
    "@types/bun": "catalog:base",
    "typescript": "catalog:base",
    "vitest": "catalog:base"
  }
}

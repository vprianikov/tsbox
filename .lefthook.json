{
  "commit-msg": {
    "jobs": [
      {
        "run": "bun run commitlint --edit {1}"
      }
    ]
  },
  "pre-commit": {
    "jobs": [
      {
        "run": "bun install --frozen-lockfile --ignore-scripts"
      },
      {
        "run": "bun run typecheck"
      },
      {
        "run": "bun run test"
      }
    ]
  }
}

{
  "commit-msg": {
    "jobs": [
      {
        "run": "npx --no -- commitlint --edit {1}"
      }
    ]
  },
  "pre-commit": {
    "jobs": [
      {
        "run": "npm ci --dry-run --ignore-scripts --no-audit --no-fund"
      },
      {
        "run": "npx --no -- tsc --noEmit"
      },
      {
        "run": "npx --no -- vitest run --reporter=agent --coverage --coverage.reporter=text-summary --coverage.include='src/**/*.ts'  --coverage.exclude='src/main.ts' --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.statements=80 --coverage.thresholds.branches=70"
      },
      {
        "run": "npx --no -- eslint . --max-warnings=0"
      },
      {
        "run": "npx --no -- prettier --check ."
      },
      {
        "run": "npx --no -- knip"
      }
    ]
  }
}

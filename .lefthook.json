{
  "commit-msg": {
    "jobs": [
      {
        "run": "npx --no -- commitlint --edit {1}"
      }
    ]
  },
  "pre-commit": {
    "jobs": [
      {
        "run": "npm ci --dry-run --ignore-scripts --no-audit --no-fund"
      },
      {
        "run": "npx --no -- prettier --check ."
      }
    ]
  }
}

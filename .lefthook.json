{
  "commit-msg": {
    "jobs": [
      {
        "run": "bun run commit:check {1}"
      }
    ]
  },
  "pre-commit": {
    "jobs": [
      {
        "run": "bun install --frozen-lockfile --ignore-scripts"
      },
      {
        "run": "bun run typecheck"
      },
      {
        "run": "bun run test:coverage"
      },
      {
        "run": "bun run format:check"
      },
      {
        "run": "bun run knip:check"
      }
    ]
  }
}

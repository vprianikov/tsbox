{
  "name": "tsbox",
  "private": true,
  "description": "Modern TypeScript monorepo powered by Bun",
  "homepage": "https://github.com/vprianikov/tsbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprianikov/tsbox.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Vasilii Prianikov",
    "email": "88191516+vprianikov@users.noreply.github.com"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/**"
    ],
    "catalogs": {
      "base": {
        "@tsconfig/bun": "^1",
        "@types/bun": "^1",
        "typescript": "^5"
      }
    }
  },
  "scripts": {
    "check": "bun run lefthook run pre-commit --force",
    "clean": "git clean -Xdf && rm -f bun.lock && bun i",
    "dev": "bun run --workspaces --if-present dev",
    "format:check": "bun run prettier --check .",
    "format:fix": "bun run prettier --write .",
    "start": "bun run --workspaces --if-present start",
    "test": "bun run --workspaces --if-present test",
    "typecheck": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@ianvs/prettier-plugin-sort-imports": "^4",
    "lefthook": "^2",
    "prettier": "^3",
    "prettier-plugin-expand-json": "^1",
    "prettier-plugin-multiline-arrays": "^4",
    "prettier-plugin-packagejson": "^3",
    "prettier-plugin-sort-json": "^4"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}

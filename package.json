{
  "name": "tsbox",
  "private": true,
  "description": "Modern TypeScript monorepo powered by Bun",
  "homepage": "https://github.com/vprianikov/tsbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprianikov/tsbox.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Vasilii Prianikov",
    "email": "88191516+vprianikov@users.noreply.github.com"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ],
    "catalogs": {
      "base": {
        "@tsconfig/bun": "^1",
        "@types/bun": "^1",
        "typescript": "^5",
        "vitest": "^4"
      }
    }
  },
  "scripts": {
    "check": "bun run lefthook run pre-commit --force",
    "clean": "git clean -Xdf && rm -f bun.lock && bun i",
    "commit:check": "commitlint --edit",
    "dev": "bun run --workspaces --if-present dev",
    "fix": "bun run knip:fix && bun run format:fix",
    "format:check": "bun run prettier --check .",
    "format:fix": "bun run prettier --write .",
    "knip:check": "knip",
    "knip:fix": "knip --fix --format",
    "start": "bun run --workspaces --if-present start",
    "test": "bun run vitest run --reporter=agent",
    "test:coverage": "bun run vitest run --reporter=agent --coverage --coverage.include='**/*.ts' --coverage.exclude='**/*.test.ts' --coverage.reporter=text-summary --coverage.thresholds.branches=70 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80 --coverage.thresholds.statements=80",
    "typecheck": "bun run --workspaces typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@ianvs/prettier-plugin-sort-imports": "^4",
    "@vitest/coverage-v8": "^4",
    "knip": "^6",
    "lefthook": "^2",
    "prettier": "^3",
    "prettier-plugin-expand-json": "^1",
    "prettier-plugin-multiline-arrays": "^4",
    "prettier-plugin-packagejson": "^3",
    "prettier-plugin-sort-json": "^4",
    "vitest": "catalog:base"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}

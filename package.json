  "type": "module",
  "scripts": {
    "build": "npx --no -- tsc",
    "check": "npx --no -- lefthook run pre-commit --force",
    "clean": "git clean -Xdf && rm -f package-lock.json && npm i --no-fund",
    "dev": "npx --no -- tsx watch src/main.ts",
    "fix": "npx --no -- eslint . --fix && npx --no -- knip --fix && npx --no -- prettier --write .",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@eslint/js": "^10",
    "@eslint/json": "^2",
    "@eslint/markdown": "^8",
    "@ianvs/prettier-plugin-sort-imports": "^4",
    "@tsconfig/node26": "^26",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "globals": "^17",
    "knip": "^6",
    "lefthook": "^2",
    "prettier": "^3",
    "prettier-plugin-expand-json": "^1",
    "prettier-plugin-packagejson": "^3",
    "prettier-plugin-sort-json": "^4",
    "tsx": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "volta": {
    "node": "26.5.1"
  },
  "allowScripts": {
    "lefthook": true
  }
}

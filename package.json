{
  "name": "tsbox",
  "version": "0.1.0",
  "description": "Modern TypeScript monorepo powered by Bun",
  "homepage": "https://github.com/vprianikov/tsbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprianikov/tsbox.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Vasilii Prianikov",
    "email": "88191516+vprianikov@users.noreply.github.com"
  },
  "type": "module",
  "scripts": {
    "check": "bun run deps:check && bun run typecheck && bun run test",
    "clean": "git clean -Xdf && rm -f bun.lock && bun i",
    "deps:check": "bun install --frozen-lockfile --ignore-scripts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "^5"
  },
  "peerDependencies": {}
}
